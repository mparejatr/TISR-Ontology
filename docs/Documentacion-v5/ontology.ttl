@prefix : <http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4#> .

<http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4> rdf:type owl:Ontology ;
                                                                            <http://purl.org/dc/elements/1.1/creator> "Miguel Angel Pareja" ;
                                                                            <http://purl.org/dc/elements/1.1/title> "TISR-Ontology" ;
                                                                            <http://purl.org/dc/terms/abstract> "The TISR-Ontology has been developed to address the growing need for structured and interoperable information within the domain of urban tourism. In increasingly connected cities, tourism management requires the integration of heterogeneous data sources to provide more personalized, dynamic, and efficient services to visitors." ;
                                                                            <http://purl.org/dc/terms/description> """The purpose of this ontology is to establish a tourist map of cities of interest, providing a knowledge structure that enables:

      • Improving the organization and accessibility of tourism information.
      • Supporting automatic personalized recommendation mechanisms.
      • Facilitating the integration of open and heterogeneous data sources.
      • Promoting interoperability between smart tourism service platforms.

The main use case consists of a smart tourism system that offers personalized recommendations to visitors, such as:

      • Suggesting relevant events based on user location and preferences.
      • Recommending hotels based on price range and user ratings.
      • Guiding users in selecting tourist attractions according to their interests.""" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/creator
<http://purl.org/dc/elements/1.1/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/title
<http://purl.org/dc/elements/1.1/title> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/abstract
<http://purl.org/dc/terms/abstract> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#sameAs
rdfs:sameAs rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/heldIn
<http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/heldIn> rdf:type owl:ObjectProperty ;
                                                                                  rdfs:domain [ rdf:type owl:Restriction ;
                                                                                                owl:onProperty <http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/locatedIn> ;
                                                                                                owl:someValuesFrom <http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Event>
                                                                                              ] ;
                                                                                  rdfs:range [ rdf:type owl:Restriction ;
                                                                                               owl:onProperty owl:topObjectProperty ;
                                                                                               owl:someValuesFrom <http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/City>
                                                                                             ] ;
                                                                                  rdfs:comment "Relationship with the city where the event is held" ;
                                                                                  rdfs:label "heldIn" .


###  http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/locatedIn
<http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/locatedIn> rdf:type owl:ObjectProperty ;
                                                                                     rdfs:domain [ rdf:type owl:Restriction ;
                                                                                                   owl:onProperty <http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/locatedIn> ;
                                                                                                   owl:someValuesFrom <http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Attraction>
                                                                                                 ] ,
                                                                                                 [ rdf:type owl:Restriction ;
                                                                                                   owl:onProperty <http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/locatedIn> ;
                                                                                                   owl:someValuesFrom <http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Hotel>
                                                                                                 ] ,
                                                                                                 [ rdf:type owl:Restriction ;
                                                                                                   owl:onProperty <http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/locatedIn> ;
                                                                                                   owl:someValuesFrom <http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Restaurant>
                                                                                                 ] ,
                                                                                                 [ rdf:type owl:Restriction ;
                                                                                                   owl:onProperty <http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/locatedIn> ;
                                                                                                   owl:someValuesFrom <http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Transport>
                                                                                                 ] ;
                                                                                     rdfs:range [ rdf:type owl:Restriction ;
                                                                                                  owl:onProperty owl:topObjectProperty ;
                                                                                                  owl:someValuesFrom <http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/City>
                                                                                                ] ;
                                                                                     rdfs:comment "Relationship with the city class" ;
                                                                                     rdfs:label "locatedIn" .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/averagePrice
<http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/averagePrice> rdf:type owl:DatatypeProperty ;
                                                                                        rdfs:subPropertyOf owl:topDataProperty ;
                                                                                        rdfs:domain <http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Restaurant> ,
                                                                                                    <http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Transport> ;
                                                                                        rdfs:range xsd:float ;
                                                                                        rdfs:comment "The average cost of a meal or service" ;
                                                                                        rdfs:label "averagePrice" .


###  http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/company
<http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/company> rdf:type owl:DatatypeProperty ;
                                                                                   rdfs:subPropertyOf owl:topDataProperty ;
                                                                                   rdf:type owl:FunctionalProperty ;
                                                                                   rdfs:domain <http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Transport> ;
                                                                                   rdfs:range xsd:string ;
                                                                                   rdfs:comment "The transport service provider company" ;
                                                                                   rdfs:label "company" .


###  http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/cuisineType
<http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/cuisineType> rdf:type owl:DatatypeProperty ;
                                                                                       rdfs:subPropertyOf owl:topDataProperty ;
                                                                                       rdf:type owl:FunctionalProperty ;
                                                                                       rdfs:domain <http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Restaurant> ;
                                                                                       rdfs:range xsd:string ;
                                                                                       rdfs:comment "The type of cuisine offered by a restaurant" ;
                                                                                       rdfs:label "cuisineType" .


###  http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/date
<http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/date> rdf:type owl:DatatypeProperty ;
                                                                                rdfs:subPropertyOf owl:topDataProperty ;
                                                                                rdfs:domain <http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Event> ;
                                                                                rdfs:range xsd:string ;
                                                                                rdfs:comment "The date of an event" ;
                                                                                rdfs:label "date" .


###  http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/location
<http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/location> rdf:type owl:DatatypeProperty ;
                                                                                    rdfs:subPropertyOf owl:topDataProperty ;
                                                                                    rdf:type owl:FunctionalProperty ;
                                                                                    rdfs:domain <http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/City> ;
                                                                                    rdfs:range xsd:string ;
                                                                                    rdfs:comment "The geographical location(lat, long) of the city" ;
                                                                                    rdfs:label "location" .


###  http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/name
<http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/name> rdf:type owl:DatatypeProperty ;
                                                                                rdfs:subPropertyOf owl:topDataProperty ;
                                                                                rdf:type owl:FunctionalProperty ;
                                                                                rdfs:domain <http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Attraction> ,
                                                                                            <http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/City> ,
                                                                                            <http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Event> ,
                                                                                            <http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Hotel> ,
                                                                                            <http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Restaurant> ;
                                                                                rdfs:range xsd:string ;
                                                                                rdfs:comment "The official name of the entity" ;
                                                                                rdfs:label "name" .


###  http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/price
<http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/price> rdf:type owl:DatatypeProperty ;
                                                                                 rdfs:subPropertyOf owl:topDataProperty ;
