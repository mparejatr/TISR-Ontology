                                                                                                      owl:onProperty <http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/name> ;
                                                                                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                      owl:onDataRange xsd:string
                                                                                                    ] ;
                                                                                rdfs:comment "A populated urban area" ;
                                                                                rdfs:label "City" .


