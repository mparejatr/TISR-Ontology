                                                                                 rdfs:range xsd:float ;
                                                                                 rdfs:comment "The price per night in a hotel" ;
                                                                                 rdfs:label "price" .


###  http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/rating
<http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/rating> rdf:type owl:DatatypeProperty ;
                                                                                  rdfs:subPropertyOf owl:topDataProperty ;
                                                                                  rdfs:domain <http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Attraction> ,
                                                                                              <http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Hotel> ,
                                                                                              <http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Restaurant> ;
                                                                                  rdfs:range xsd:float ;
                                                                                  rdfs:comment "The rating given by customers" ;
                                                                                  rdfs:label "rating" .


###  http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/stars
<http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/stars> rdf:type owl:DatatypeProperty ;
                                                                                 rdfs:subPropertyOf owl:topDataProperty ;
                                                                                 rdfs:domain <http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Hotel> ;
                                                                                 rdfs:range xsd:integer ;
                                                                                 rdfs:comment "represent the Hotels quality level" ;
                                                                                 rdfs:label "stars" .


###  http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/type
<http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/type> rdf:type owl:DatatypeProperty ;
                                                                                rdfs:subPropertyOf owl:topDataProperty ;
                                                                                rdf:type owl:FunctionalProperty ;
                                                                                rdfs:domain <http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Attraction> ,
                                                                                            <http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Event> ,
                                                                                            <http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Transport> ;
                                                                                rdfs:range xsd:string ;
                                                                                rdfs:comment "The category or classification of the entity" ;
                                                                                rdfs:label "type" .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Attraction
<http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Attraction> rdf:type owl:Class ;
                                                                                      owl:equivalentClass [ rdf:type owl:Restriction ;
                                                                                                            owl:onProperty <http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/locatedIn> ;
                                                                                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                            owl:onClass <http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/City>
                                                                                                          ] ,
                                                                                                          [ rdf:type owl:Restriction ;
                                                                                                            owl:onProperty <http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/name> ;
                                                                                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                            owl:onDataRange xsd:string
                                                                                                          ] ;
                                                                                      rdfs:comment "A place of interest where tourists visit, typically for its cultural value, historical significance, or natural beauty" ;
                                                                                      rdfs:label "Attraction" .


###  http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/BeachHotel
<http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/BeachHotel> rdf:type owl:Class ;
