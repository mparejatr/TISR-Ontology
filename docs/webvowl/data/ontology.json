    "title" : {
      "undefined" : "TISR-Ontology"
    },
    "iri" : "http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4",
    "author" : [ "Miguel Angel Pareja" ],
    "description" : {
      "undefined" : "The purpose of this ontology is to establish a tourist map of cities of interest, providing a knowledge structure that enables:\n\n      • Improving the organization and accessibility of tourism information.\n      • Supporting automatic personalized recommendation mechanisms.\n      • Facilitating the integration of open and heterogeneous data sources.\n      • Promoting interoperability between smart tourism service platforms.\n\nThe main use case consists of a smart tourism system that offers personalized recommendations to visitors, such as:\n\n      • Suggesting relevant events based on user location and preferences.\n      • Recommending hotels based on price range and user ratings.\n      • Guiding users in selecting tourist attractions according to their interests."
    },
    "other" : {
      "creator" : [ {
        "identifier" : "creator",
        "language" : "undefined",
        "value" : "Miguel Angel Pareja",
        "type" : "label"
      } ],
      "abstract" : [ {
        "identifier" : "abstract",
        "language" : "undefined",
        "value" : "The TISR-Ontology has been developed to address the growing need for structured and interoperable information within the domain of urban tourism. In increasingly connected cities, tourism management requires the integration of heterogeneous data sources to provide more personalized, dynamic, and efficient services to visitors.",
        "type" : "label"
      } ],
      "title" : [ {
        "identifier" : "title",
        "language" : "undefined",
        "value" : "TISR-Ontology",
        "type" : "label"
      } ]
    }
  },
