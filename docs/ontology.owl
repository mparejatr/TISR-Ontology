        <rdfs:comment>The rating given by customers</rdfs:comment>
        <rdfs:label>rating</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/stars -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/stars">
