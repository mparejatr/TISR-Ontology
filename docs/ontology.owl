        <rdfs:domain rdf:resource="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Hotel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>represent the Hotels quality level</rdfs:comment>
        <rdfs:label>stars</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/type -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/type">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Attraction"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Event"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Transport"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The category or classification of the entity</rdfs:comment>
        <rdfs:label>type</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Attraction -->


    <owl:Class rdf:about="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Attraction">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/locatedIn"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/City"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/name"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:comment>A place of interest where tourists visit, typically for its cultural value, historical significance, or natural beauty</rdfs:comment>
        <rdfs:label>Attraction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/BeachHotel -->


    <owl:Class rdf:about="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/BeachHotel">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Hotel"/>
        <rdfs:comment>A hotel located near a beach or coastal area.</rdfs:comment>
        <rdfs:label>Beach Hotel</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/BusTransport -->


    <owl:Class rdf:about="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/BusTransport">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Transport"/>
        <rdfs:comment>Public transport service using buses</rdfs:comment>
        <rdfs:label>BusTransport</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/BusinessHotel -->


    <owl:Class rdf:about="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/BusinessHotel">
