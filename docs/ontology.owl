    <!-- http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/averagePrice -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/averagePrice">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Restaurant"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Transport"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>The average cost of a meal or service</rdfs:comment>
        <rdfs:label>averagePrice</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/company -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/company">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Transport"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The transport service provider company</rdfs:comment>
        <rdfs:label>company</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/cuisineType -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/cuisineType">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Restaurant"/>
