    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/elements/1.1/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/creator"/>
    


    <!-- http://purl.org/dc/elements/1.1/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/title"/>
    


    <!-- http://purl.org/dc/terms/abstract -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/abstract"/>
    


    <!-- http://purl.org/dc/terms/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://www.w3.org/2000/01/rdf-schema#sameAs -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#sameAs"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/heldIn -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/heldIn">
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/locatedIn"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Event"/>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:range>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/City"/>
            </owl:Restriction>
        </rdfs:range>
        <rdfs:comment>Relationship with the city where the event is held</rdfs:comment>
        <rdfs:label>heldIn</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/locatedIn -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/locatedIn">
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/locatedIn"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Attraction"/>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/locatedIn"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Hotel"/>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/locatedIn"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Restaurant"/>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/locatedIn"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Transport"/>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:range>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/City"/>
            </owl:Restriction>
        </rdfs:range>
        <rdfs:comment>Relationship with the city class</rdfs:comment>
        <rdfs:label>locatedIn</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
