        <rdfs:comment>The type of cuisine offered by a restaurant</rdfs:comment>
        <rdfs:label>cuisineType</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/date -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/date">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Event"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The date of an event</rdfs:comment>
        <rdfs:label>date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/location -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/location">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/City"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The geographical location(lat, long) of the city</rdfs:comment>
        <rdfs:label>location</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/name -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/name">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Attraction"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/City"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Event"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Hotel"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Restaurant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The official name of the entity</rdfs:comment>
        <rdfs:label>name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/price -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/price">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Hotel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>The price per night in a hotel</rdfs:comment>
        <rdfs:label>price</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/rating -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/rating">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Attraction"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Hotel"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Restaurant"/>
