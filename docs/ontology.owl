        <rdfs:comment>A hotel catering primarily to business travelers.</rdfs:comment>
        <rdfs:label>Business Hotel</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/City -->


    <owl:Class rdf:about="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/City">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/location"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/name"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:comment>A populated urban area</rdfs:comment>
        <rdfs:label>City</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Concert -->


    <owl:Class rdf:about="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Concert">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Event"/>
        <rdfs:comment>A live musical performance before an audience</rdfs:comment>
        <rdfs:label>Concert</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/CulturalCenter -->


    <owl:Class rdf:about="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/CulturalCenter">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Attraction"/>
        <rdfs:comment>A facility dedicated to cultural activities</rdfs:comment>
        <rdfs:label>CulturalCenter</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/CulturalExhibition -->


    <owl:Class rdf:about="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/CulturalExhibition">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Event"/>
        <rdfs:comment>An event of cultural interest</rdfs:comment>
        <rdfs:label>CulturalExhibition</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Event -->


    <owl:Class rdf:about="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Event">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/heldIn"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/City"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/name"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:comment>An organized occasion such as a festival or concert</rdfs:comment>
        <rdfs:label>Event</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Festival -->


    <owl:Class rdf:about="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Festival">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Event"/>
        <rdfs:comment>A day or period of celebration</rdfs:comment>
        <rdfs:label>Festival</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/GastronomicFair -->


    <owl:Class rdf:about="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/GastronomicFair">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Event"/>
        <rdfs:comment>An event focused on food</rdfs:comment>
        <rdfs:label>GastronomicFair</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/GourmetRestaurant -->


    <owl:Class rdf:about="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/GourmetRestaurant">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/reboots/ontologies/2025/3/untitled-ontology-4/Restaurant"/>
        <rdfs:comment>A restaurant specializing in high-quality, often luxurious food</rdfs:comment>
        <rdfs:label>Gourmet Restaurant</rdfs:label>
